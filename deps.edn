{:paths ["src" "resources"]
 :deps  {org.clojure/clojure              {:mvn/version "1.12.5"}
         com.walmartlabs/lacinia          {:mvn/version "1.3.0"}
         ;; ブラウザ (GraphiQL) からクエリを試すための HTTP サーバ
         com.walmartlabs/lacinia-pedestal {:mvn/version "1.3"}
         io.pedestal/pedestal.service     {:mvn/version "0.7.2"}
         io.pedestal/pedestal.jetty       {:mvn/version "0.7.2"}}

 :aliases
 {;; エディタ (VSCode/Calva, CIDER など) から繋ぐ用の nREPL
  :dev {:extra-deps {nrepl/nrepl       {:mvn/version "1.3.1"}
                     cider/cider-nrepl {:mvn/version "0.50.2"}}
        :main-opts  ["-m" "nrepl.cmdline" "--middleware" "[cider.nrepl/cider-middleware]"]}}}
